{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Check",
  "version": "0.1.0",
  "identifier": "com.maxime272003.check",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Check",
        "width": 1120,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Checklists de bureau qui se décochent toutes seules",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZENDEyQjYxREQ5NDFEM0QKUldROUhaVGRZU3RCYlhLYVcwRW40WmJyRTdXOVEwZXR5SEl2RW5ZU1hJNCtFaVo3cXFua3VHdS8K",
      "endpoints": [
        "https://github.com/Maxime272003/Check/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
